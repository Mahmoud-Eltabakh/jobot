# Jobot Environment Configuration Example

# Application Settings
APP_NAME=Jobot
ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Account Security & Encryption
# Production deployments must provide ENCRYPTION_KEY through a secret manager.
# Windows Users: We strongly recommend generating and setting ENCRYPTION_KEY explicitly, as local file ACLs are less reliable.
SECRET_KEY=
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=local
ENCRYPTION_KEY_FILE=data/.jobot-encryption-key
# Rotation format: previous-key-id:previous-key,older-key-id:older-key
PREVIOUS_ENCRYPTION_KEYS=

# Database & Vector Store Settings
DATABASE_URL=sqlite:///data/jobot.db
CHROMA_DIR=data/chroma

# AI Provider Configuration
# Supported providers: "ollama" or "openai" / "custom"
AI_PROVIDER=ollama

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud / Custom AI Provider (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Scraper Settings
SCRAPER_DEFAULT_INTERVAL_HOURS=12
SCRAPER_HEADLESS=true

# Tailscale SSH Remote Access Preferences
# Jobot only displays status and connection guidance; it does not run privileged commands.
TAILSCALE_ENABLED=false
TAILSCALE_HOSTNAME=
TAILSCALE_SSH_USER=
TAILSCALE_SSH_PORT=22
TAILSCALE_APP_PORT=8000
TAILSCALE_MAGIC_DNS=true
