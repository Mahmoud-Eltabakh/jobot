# Jobot Environment Configuration Example

# Application Settings
APP_NAME=Jobot
ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Database & Vector Store Settings
DATABASE_URL=sqlite:///data/jobot.db
CHROMA_DIR=data/chroma

# AI Provider Configuration
# Supported providers: "ollama" or "openai" / "custom"
AI_PROVIDER=ollama

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud / Custom AI Provider (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Scraper Settings
SCRAPER_DEFAULT_INTERVAL_HOURS=12
SCRAPER_HEADLESS=true
