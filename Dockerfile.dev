# Development Dockerfile with Playwright browser dependencies and hot reloading
FROM python:3.11-slim

LABEL org.opencontainers.image.title="Jobot-Dev" \
      org.opencontainers.image.description="Intelligent AI Job Search Agent - Development" \
      org.opencontainers.image.version="0.1.0-dev" \
      org.opencontainers.image.vendor="Jobot" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /app

# Install system packages required by Playwright Chromium and SQLite
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    gnupg \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    fonts-liberation \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy and install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    playwright install chromium

# Copy application source code
COPY . .

# Expose FastAPI application port
EXPOSE 8000

# Run uvicorn with live reload for development
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
